# Public, absolute URL of the live site (no trailing slash).
# Used for canonical links, Open Graph tags, sitemap.xml and robots.txt.
VITE_SITE_URL=https://www.example.com

# Optional: where the enquiry form posts. Leave unset to use Netlify Forms
# (the form posts to "/" and Netlify captures it). Set this only to a public
# form endpoint — never put API keys or secrets in VITE_ variables, because
# they are compiled into client-side JavaScript.
# VITE_FORM_ENDPOINT=
